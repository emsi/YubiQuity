#!/bin/sh
# YubiQuity device access: user-acl-v1
# Small, root-owned installation helper. No vaults, secrets or user-supplied paths.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

usage() {
    printf '%s\n' 'Usage: sudo yubiquity-setup USER' \
        'Or use Setup in YubiQuity for a native administrator prompt.'
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
if [ "$#" -ne 1 ]; then usage >&2; exit 2; fi
if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' 'Administrator authentication is required.' >&2
    exit 1
fi
task_action=all
case "$1" in
    --desktop-device|--desktop-firefox)
        task_action=${1#--desktop-}
        case "${PKEXEC_UID:-}" in ''|*[!0-9]*) echo 'Missing pkexec caller identity.' >&2; exit 1 ;; esac
        [ "$PKEXEC_UID" -gt 0 ] || { echo 'Use a normal desktop account.' >&2; exit 1; }
        task_user=$(id -un -- "$PKEXEC_UID")
        ;;
    -*) usage >&2; exit 2 ;;
    *) task_user=$1 ;;
esac
task_uid=$(id -u -- "$task_user")
if [ "$task_uid" -eq 0 ]; then
    printf '%s\n' 'Specify your normal desktop account, not root.' >&2
    exit 1
fi
if [ "$task_action" != all ] && [ "$task_uid" -ne "$PKEXEC_UID" ]; then
    echo 'Caller identity does not match the account.' >&2
    exit 1
fi
if [ "$task_action" != firefox ]; then
    # A named-user ACL takes effect for existing processes, including browsers.
    # Keep the rule root-owned and atomic; only the UID resolved above is inserted.
    # The template matches exactly UHID and YubiQuity's matching hidraw nodes.
    # It works alongside older group rules as well as the current package rules.
    task_rule="/etc/udev/rules.d/73-yubiquity-user-$task_uid.rules"
    mkdir -p /etc/udev/rules.d
    task_temporary=$(mktemp /etc/udev/rules.d/.yubiquity-access-XXXXXX)
    trap 'rm -f -- "$task_temporary"' EXIT
    trap 'exit 1' HUP INT TERM
    sed "s/@UID@/$task_uid/g" /usr/share/yubiquity/user-access.rules.in > "$task_temporary"
    if [ -e "$task_rule" ] || [ -L "$task_rule" ]; then
        if [ -L "$task_rule" ] || ! cmp -s "$task_temporary" "$task_rule"; then
            printf 'Local access rule differs: %s. Ask an administrator to review it; it was not overwritten.\n' "$task_rule" >&2
            exit 1
        fi
    else
        chmod 0644 "$task_temporary"
        mv -T -- "$task_temporary" "$task_rule"
    fi
    rm -f -- "$task_temporary"
    trap - EXIT HUP INT TERM
    if [ ! -e /sys/class/misc/uhid ]; then modprobe uhid; fi
fi
# Reapply installed rules, preserving all locally customized files.
udevadm control --reload-rules
if [ "$task_action" != firefox ] || [ -e /sys/class/misc/uhid ]; then
    udevadm trigger --action=change /sys/class/misc/uhid
    # Refresh existing UHID children, including ones created before the new
    # rules. The scoped rule still confines ACL grants to YubiQuity devices.
    udevadm trigger --action=change --subsystem-match=hidraw --parent-match=/sys/devices/virtual/misc/uhid
fi
udevadm settle --timeout=15
if [ "$task_action" != firefox ]; then
    # Report a real failure if the ACL cannot be applied. This also grants UHID
    # immediately if udev was unable to apply the event.
    setfacl -m "u:$task_uid:rw" -- /dev/uhid
fi
if [ "$task_action" = firefox ] && ! command -v snap >/dev/null 2>&1; then
    echo 'Snap is not installed. No Firefox Snap connection can be configured.' >&2
    exit 1
fi
if [ "$task_action" != device ] && command -v snap >/dev/null 2>&1; then
    # A query failure is not proof that Firefox is absent. Bound an unavailable
    # snapd and surface the error, including when device setup already succeeded.
    task_snaps=$(timeout --kill-after=1s 15s snap list) || {
        echo 'Could not query snapd. Device rules were refreshed; Firefox setup is unconfirmed. Try again.' >&2
        exit 1
    }
    task_firefox=false
    while read -r task_name task_rest; do
        if [ "$task_name" = firefox ]; then task_firefox=true; fi
    done <<SNAPS
$task_snaps
SNAPS
    if [ "$task_firefox" = true ]; then
        timeout --kill-after=1s 30s snap connect firefox:u2f-devices
    elif [ "$task_action" = firefox ]; then
        echo 'Firefox Snap is not installed.' >&2
        exit 1
    fi
fi
printf 'Setup completed for %s.\n' "$task_user"
if [ "$task_action" != firefox ]; then
    printf '%s\n' 'Device access is enabled for your account now. No logout or reboot is needed.'
fi
if [ "$task_action" != device ]; then
    printf '%s\n' 'After Firefox repairs, lock/unlock YubiQuity and restart Firefox to recreate Snap access.'
fi
