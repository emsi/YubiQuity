# Install on the Linux host that owns UHID; this is not a container cgroup rule.
# Members can create arbitrary HID devices through UHID. Add only trusted users.
ACTION!="add|change", GOTO="yubiquity_end"
SUBSYSTEM=="misc", KERNEL=="uhid", GROUP:="yubiquity", MODE:="0660"

# All parent matches refer to the same HID parent. UHID's name/unique properties
# are in its uevent attribute, not USB idVendor/idProduct sysfs attributes.
# Device identity is a scope filter, not cryptographic authentication.
SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/*/hidraw/hidraw*", SUBSYSTEMS=="hid", KERNELS=="0003:FFFF:0001.*", ATTRS{uevent}=="*HID_NAME=YubiQuity Software FIDO2*", ATTRS{uevent}=="*HID_UNIQ=yubiquity-*", GROUP:="yubiquity", MODE:="0660", TAG-="uaccess"

# Runs after generic 70-uaccess but before 73-seat-late: only the explicitly
# selected group gets access, not every active seat user or every hidraw node.
LABEL="yubiquity_end"
