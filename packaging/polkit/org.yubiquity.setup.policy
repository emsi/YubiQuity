<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>YubiQuity</vendor>
  <vendor_url>https://github.com/emsi/YubiQuity</vendor_url>
  <action id="org.yubiquity.setup">
    <description>Configure YubiQuity device access</description>
    <message>Administrator authentication is required to configure software security-key access on this computer.</message>
    <icon_name>dialog-password</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/yubiquity-setup</annotate>
  </action>
</policyconfig>
